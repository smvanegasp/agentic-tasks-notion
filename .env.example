# Copy this file to `.env` for local development.
# `.env` is gitignored — never commit real values.
# In production these come from AWS Secrets Manager / SAM template parameters.

# === Secrets ===
TELEGRAM_BOT_TOKEN=
NOTION_TOKEN=
# Used for both chat and audio transcription. Get one from
# https://console.groq.com (default) or https://platform.openai.com.
LLM_API_KEY=

# === Notion database IDs ===
NOTION_TASKS_DB_ID=
NOTION_PROJECTS_DB_ID=

# === Single-user guard ===
# Your Telegram user ID. Find it by messaging @userinfobot.
ALLOWED_TELEGRAM_USER_ID=

# === Webhook security (required in production, optional locally) ===
# A random string Telegram echoes back as a header on every webhook request.
TELEGRAM_WEBHOOK_SECRET=

# === LLM provider (Groq by default; the OpenAI SDK speaks Groq's API) ===
# To use OpenAI directly, set LLM_BASE_URL to an empty value (or remove the
# line) and use OpenAI model names (e.g. LLM_MODEL=gpt-4o-mini,
# TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe) with an OpenAI API key.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
TRANSCRIPTION_MODEL=whisper-large-v3

# === Behavior (defaults shown; in production edit template.yaml instead) ===
TIMEZONE=America/New_York
DIGEST_TIME=08:00
CONVERSATION_HISTORY_LIMIT=40
# Max seconds the agent has to respond before the bot apologizes and bails.
AGENT_TIMEOUT_SECONDS=60
